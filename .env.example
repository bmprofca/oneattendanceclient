# Dev server port. Panel 3000, website 3002, admin 3003, API 7736.
PORT=3000

# Copy to .env.development.local or .env.production.local to override defaults

# API base URL (no trailing slash)
# Development: http://localhost:7736
# Production:  https://server.oneattendance.in
REACT_APP_API_BASE_URL=

REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_FACEBOOK_APP_ID=
REACT_APP_UPLOAD_URL=https://upload.onesaas.in/api/upload
REACT_APP_WEBSITE_URL=
